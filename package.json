{
  "name": "@almondoo/klaus",
  "version": "0.1.1",
  "description": "API 検証 CLI: YAML でリクエストフローを定義し、実行・アサーション・履歴管理を行う",
  "type": "module",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almondoo/klaus.git"
  },
  "homepage": "https://github.com/almondoo/klaus#readme",
  "bugs": {
    "url": "https://github.com/almondoo/klaus/issues"
  },
  "keywords": [
    "api",
    "testing",
    "cli",
    "http",
    "yaml",
    "sse",
    "websocket"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "klaus": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsup",
    "build:ui": "pnpm --filter @almondoo/klaus-ui build",
    "build:all": "pnpm clean && pnpm build && pnpm build:ui",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "commander": "^15",
    "eventsource-parser": "^3.1.0",
    "hono": "^4.13.1",
    "jsonpath-plus": "^10.4.0",
    "undici": "^8",
    "yaml": "^2.9.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/node": "^22.20.1",
    "@types/ws": "^8.18.1",
    "tsup": "^8.5",
    "typescript": "^5.9",
    "vitepress": "^1.6.4",
    "vitest": "^4",
    "ws": "^8.21.3"
  }
}
