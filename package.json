{
  "name": "@almondoo/klaus",
  "version": "0.8.0",
  "description": "API testing CLI: define request flows in YAML and run execution, assertions, and history tracking",
  "type": "module",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almondoo/klaus.git"
  },
  "homepage": "https://github.com/almondoo/klaus#readme",
  "bugs": {
    "url": "https://github.com/almondoo/klaus/issues"
  },
  "keywords": [
    "api",
    "testing",
    "cli",
    "http",
    "yaml",
    "sse",
    "websocket"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "klaus": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/cli.js",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/server.js",
    "dist/schema/*.json",
    "dist/ui/**/*.html",
    "dist/ui/**/*.css",
    "dist/ui/**/*.js",
    "dist/ui/**/*.woff",
    "dist/ui/**/*.woff2",
    "THIRD_PARTY_LICENSES.md",
    "skills/**/*.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsup",
    "build:schema": "node dist/schema-gen.js",
    "build:schema:docs": "node dist/schema-gen.js --docs",
    "build:ui": "pnpm --filter @almondoo/klaus-ui build",
    "build:all": "pnpm clean && pnpm build && pnpm build:schema && pnpm build:ui",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@biomejs/biome": "^2",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "ajv": "^8.20.0",
    "commander": "^15",
    "eventsource-parser": "^3.1.0",
    "hono": "^4.13.1",
    "jsonpath-plus": "^10.4.0",
    "tsup": "^8.5",
    "typescript": "^5.9",
    "undici": "^8",
    "vitepress": "2.0.0-alpha.19",
    "vitepress-plugin-llms": "^1.13.4",
    "vitest": "^4",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  }
}
